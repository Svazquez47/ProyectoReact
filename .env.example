# Copiá este archivo como .env y completá tu clave de https://rawg.io/apidocs
VITE_RAWG_API_KEY=tu_clave_aca

# Poné true para usar solo los datos de prueba (src/data/gamesMock.js), sin llamar a RAWG
VITE_USE_MOCK=false

# Clave gratuita de Gemini (https://aistudio.google.com/apikey) para crear guías con IA
VITE_GEMINI_API_KEY=tu_clave_aca
# Opcional: modelo a usar (si Google lo da de baja, cambialo acá)
VITE_GEMINI_MODEL=gemini-2.5-flash
